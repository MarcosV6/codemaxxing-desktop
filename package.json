{
  "name": "codemaxxing-desktop",
  "version": "1.2.4",
  "description": "Native desktop app for Codemaxxing — the open-source coding agent. Connect any LLM, drive a real agent loop, on macOS, Windows, and Linux.",
  "homepage": "https://github.com/MarcosV6/codemaxxing-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcosV6/codemaxxing-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/MarcosV6/codemaxxing-desktop/issues"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:app": "vite build",
    "preview": "vite preview",
    "electron:dev": "vite --host",
    "electron:build": "tsc && vite build && electron-builder",
    "electron:build:mac": "tsc && vite build && electron-builder --mac",
    "electron:build:win": "tsc && vite build && electron-builder --win",
    "electron:build:linux": "tsc && vite build && electron-builder --linux",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "ai",
    "ai-agent",
    "coding-agent",
    "agent",
    "desktop",
    "electron",
    "react",
    "macos",
    "windows",
    "linux",
    "llm",
    "local-llm",
    "lm-studio",
    "ollama",
    "anthropic",
    "openai",
    "openrouter",
    "claude",
    "codemaxxing",
    "mcp"
  ],
  "author": {
    "name": "Marcos Vallejo",
    "email": "MarcosV6@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.codemaxxing.app",
    "productName": "Codemaxxing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "hardenedRuntime": false,
      "entitlements": null,
      "entitlementsInherit": null
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 380,
          "y": 220
        },
        {
          "x": 130,
          "y": 100
        },
        {
          "x": 380,
          "y": 100
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "signtoolOptions": {
        "publisherName": "Marcos Vallejo"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Development",
      "synopsis": "Native desktop app for the codemaxxing coding agent",
      "description": "Connect any LLM (local or remote) and drive a real agent loop from a polished GUI."
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "better-sqlite3": "^12.6.2",
    "conf": "^13.0.0",
    "electron-store": "^10.0.0",
    "imapflow": "^1.3.6",
    "lucide-react": "^0.469.0",
    "mailparser": "^3.9.9",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "open": "^10.1.0",
    "openai": "^4.80.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^9.0.1",
    "react-virtuoso": "^4.18.6",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "tsdav": "^2.2.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.0.6",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
