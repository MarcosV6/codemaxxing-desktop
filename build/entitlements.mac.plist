<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened-runtime / notarized build path.

  These are inert until you flip `mac.hardenedRuntime` to true and point
  `mac.entitlements` / `mac.entitlementsInherit` at this file in package.json
  (see docs/BUILDING.md → "Code signing & notarization"). Electron's V8 needs
  the JIT entitlements; library-validation is disabled because the app loads an
  unsigned native addon (better-sqlite3).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
